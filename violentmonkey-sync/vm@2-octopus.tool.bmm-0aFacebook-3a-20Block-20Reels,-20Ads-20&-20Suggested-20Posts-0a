{"version":2,"custom":{"origInclude":true,"origExclude":true,"origMatch":true,"origExcludeMatch":true,"origTag":true,"pathMap":{}},"config":{"enabled":1,"httpOnly":0,"removed":0,"shouldUpdate":1},"props":{"lastUpdated":1793167997494},"code":"// ==UserScript==\n// @name         Facebook: Block Reels, Ads & Suggested Posts\n// @namespace    octopus.tool.bmm\n// @version      1.2.0\n// @description  屏蔽 Facebook 上所有 Reels / 短视频（导航入口、货架、单条 Reel，/reel(s)/ 跳回首页），以及信息流里的广告帖（Sponsored）和推荐帖（作者名旁带 Follow）\n// @match        https://www.facebook.com/*\n// @match        https://web.facebook.com/*\n// @match        https://m.facebook.com/*\n// @run-at       document-start\n// @grant        none\n// ==/UserScript==\n\n/*\n * Facebook 的 class 名是混淆后的随机串（x1lliihq 之类），每次发版都会变，\n * 不能拿来做选择器。所以只依赖比较稳定的东西：\n *   - 链接地址：/reel/<id>、/reels/\n *   - 结构属性：data-pagelet=\"FeedUnit_*\"、aria-posinset（信息流帖子）、role\n *   - 文字：货架标题 \"Reels\" / \"Reels and short videos\" / \"短视频\" 等\n *\n * 三层防线（和 youtube-block-shorts.user.js 同一思路）：\n *   1. CSS（document-start 注入）：按链接 + :has() 隐藏，首屏不闪。Firefox 121+。\n *   2. URL 拦截：/reel/ 和 /reels/ 一律 replace 到首页。Facebook 是 SPA，\n *      靠 history.pushState 跳转，所以要包一层 pushState/replaceState。\n *   3. MutationObserver：处理只能按文字识别的货架（标题是 \"Reels\" 但里面的\n *      链接可能还没懒加载出来）。\n */\n(function () {\n  'use strict';\n\n  const REEL_LINK = 'a[href*=\"/reel/\"], a[href*=\"/reels/\"]';\n  const REEL_PATH = /^\\/(reel|reels)(\\/|$)/;\n\n  // 信息流里“一条帖子 / 一个货架”的外层容器。\n  // 不直接用 [role=\"article\"]：评论也是 role=article，会误伤到只隐藏半个帖子。\n  const FEED_UNITS = [\n    'div[data-pagelet^=\"FeedUnit\"]',\n    'div[aria-posinset]',\n    'div[role=\"feed\"] > div',\n  ];\n\n  // 货架标题（不同语言界面）\n  const SHELF_TITLE = /^(reels|reels and short videos|short videos|reels 和短视频|reels和短视频|短视频|短影片|reels 和短影片)$/i;\n\n  // 广告标记（不同语言界面）。Facebook 会把 \"Sponsored\" 拆成乱序的单字母 span，\n  // 靠文字不可靠，所以先用广告链接 /ads/about 兜底，文字/aria-label 作补充。\n  const SPONSORED_TEXT = /^(ad|ads|sponsored|suggested for you|赞助内容|赞助|贊助|贊助內容|广告|廣告)$/i;\n  const AD_LINK = 'a[href*=\"/ads/about\"], a[href*=\"ad_id=\"], a[href*=\"/ads/preferences\"]';\n\n  // 新版 Facebook 把 \"Ad\" 标签画成 SVG 矢量图（<use> 套 <use>），页面里没有任何文字可读，\n  // 上面的文字/链接规则都会失效。改用 data-ad-rendering-role 这类结构特征（实测）：\n  //   - 广告带行动按钮：role 为 cta / cta-N（Learn more、Send message 之类）\n  //   - Marketplace 推荐商品广告（\"xxx listed an item\"）：有点赞和分享，但没有评论按钮；\n  //     正常帖子都有 comment_button\n  const AD_CTA = '[data-ad-rendering-role^=\"cta\"]';\n\n  // 帖子头部的 Follow 按钮文字（推荐帖的特征）。\"Join\" 是推荐小组，一并算上。\n  const FOLLOW_TEXT = /^(follow|join|关注|關注|追蹤|加入)$/i;\n  // Follow 必须出现在帖子顶部这个高度内才算“头部”，避免误伤正文/评论里的 Follow\n  const HEADER_MAX_PX = 110;\n\n  // ---------- 1. CSS ----------\n  const CSS = `\n    /* 左侧栏 / 顶部导航 / 快捷方式里的 Reels 入口 */\n    [role=\"navigation\"] li:has(a[href*=\"/reel/\"]),\n    [role=\"navigation\"] li:has(a[href*=\"/reels/\"]),\n    [role=\"navigation\"] a[href*=\"/reel/\"],\n    [role=\"navigation\"] a[href*=\"/reels/\"],\n    [role=\"tablist\"] a[href*=\"/reel/\"],\n    [role=\"tablist\"] a[href*=\"/reels/\"],\n\n    /* 信息流：含 Reel 链接的帖子 / Reels 货架 */\n    ${FEED_UNITS.map((u) => `${u}:has(${REEL_LINK})`).join(',\\n    ')},\n\n    /* 视频页 / 搜索结果 / 个人主页的 Reels 区块 */\n    [role=\"main\"] [role=\"article\"]:has(> div ${REEL_LINK}),\n    a[href$=\"/reels_tab\"],\n    a[href*=\"/reels_tab/\"],\n    a[href*=\"sk=reels\"],\n\n    /* 广告帖：带 /ads/about 等广告链接 */\n    ${FEED_UNITS.map((u) => `${u}:has(${AD_LINK})`).join(',\\n    ')},\n\n    /* 广告帖：带 cta 行动按钮；或有点赞但没有评论按钮（Marketplace 推荐商品） */\n    ${FEED_UNITS.map((u) => `${u}:has(${AD_CTA})`).join(',\\n    ')},\n    ${FEED_UNITS.map(\n      (u) => `${u}:has([data-ad-rendering-role=\"like_button\"]):not(:has([data-ad-rendering-role=\"comment_button\"]))`,\n    ).join(',\\n    ')},\n\n    /* 移动版 m.facebook.com */\n    article:has(${REEL_LINK}),\n    div[data-type=\"vscroller\"] > div:has(${REEL_LINK})\n    {\n      display: none !important;\n    }\n  `;\n\n  function injectCSS() {\n    const style = document.createElement('style');\n    style.id = 'fb-block-reels';\n    style.textContent = CSS;\n    (document.head || document.documentElement).appendChild(style);\n  }\n\n  // ---------- 2. URL 拦截 ----------\n  function isReelURL(url) {\n    try {\n      return REEL_PATH.test(new URL(url, location.href).pathname);\n    } catch (_) {\n      return false;\n    }\n  }\n\n  function redirectIfReel(url) {\n    if (!isReelURL(url || location.href)) return false;\n    location.replace(`${location.origin}/`);\n    return true;\n  }\n\n  // SPA 内部跳转：在 pushState 发生之前就拦下，Reels 播放器不会被挂载\n  function hookHistory() {\n    for (const name of ['pushState', 'replaceState']) {\n      const orig = history[name];\n      history[name] = function (state, title, url) {\n        if (url != null && isReelURL(url)) {\n          redirectIfReel(url);\n          return;\n        }\n        return orig.apply(this, arguments);\n      };\n    }\n    window.addEventListener('popstate', () => redirectIfReel());\n  }\n\n  // 点击捕获：有些入口不是走 pushState，而是先拦截 click 再自己处理\n  function hookClicks() {\n    document.addEventListener(\n      'click',\n      (e) => {\n        const a = e.target.closest && e.target.closest('a[href]');\n        if (a && isReelURL(a.href)) {\n          e.preventDefault();\n          e.stopImmediatePropagation();\n        }\n      },\n      true,\n    );\n  }\n\n  // ---------- 3. 按文字匹配的货架 ----------\n  function hideEl(el) {\n    if (el && el.style.display !== 'none') el.style.setProperty('display', 'none', 'important');\n  }\n\n  function hideByText() {\n    // 货架标题一般是 h2/h3 或 span[dir=\"auto\"]，只看叶子文本，避免整页 textContent 扫描\n    document.querySelectorAll('h2, h3, span[dir=\"auto\"]').forEach((el) => {\n      if (el.childElementCount > 1) return;\n      if (!SHELF_TITLE.test(el.textContent.trim())) return;\n      for (const sel of FEED_UNITS) {\n        const unit = el.closest(sel);\n        if (unit) {\n          hideEl(unit);\n          return;\n        }\n      }\n      // 不在信息流里：可能是导航/标签栏里的 \"Reels\" 文字入口\n      hideEl(el.closest('[role=\"navigation\"] li, [role=\"tab\"], [role=\"tablist\"] a, [role=\"link\"]'));\n    });\n  }\n\n  // ---------- 4. 广告帖 / 推荐帖 ----------\n  function findUnit(el) {\n    for (const sel of FEED_UNITS) {\n      const unit = el.closest(sel);\n      if (unit) return unit;\n    }\n    return null;\n  }\n\n  // Facebook 把 \"Sponsored\"/\"Ad\" 拆成几十个单字符 span，并且：\n  //   - 干扰字符带 style=\"position:absolute\" 被挪出视野；\n  //   - 真字符在 DOM 里的顺序是乱的（\"Ad\" 会是 \"dA\"），靠 CSS 在屏幕上排回来；\n  //   - 每个字符后还附一个不可见的 U+034F。\n  // 所以：跳过绝对定位和零宽的 span，按屏幕横坐标排序，再去掉 U+034F。\n  function visibleText(a) {\n    const parts = [];\n    a.querySelectorAll('span').forEach((sp) => {\n      if (sp.childElementCount !== 0 || sp.style.position === 'absolute') return;\n      const r = sp.getBoundingClientRect();\n      if (r.width > 0 && r.height > 0) parts.push({ x: r.left, t: sp.textContent });\n    });\n    parts.sort((p, q) => p.x - q.x);\n    return parts.map((p) => p.t).join('').replace(/\\u034f/g, '').trim();\n  }\n\n  function hideAdsAndSuggested() {\n    // 广告：被拆成乱序字符的标签链接（主要路径）\n    const seen = new Set();\n    document.querySelectorAll('a span[style*=\"position: absolute\"]').forEach((sp) => {\n      const a = sp.closest('a');\n      if (!a || seen.has(a)) return;\n      seen.add(a);\n      if (!SPONSORED_TEXT.test(visibleText(a))) return;\n      const unit = findUnit(a);\n      if (unit) hideEl(unit);\n    });\n\n    // 广告：Sponsored 标签（文字或 aria-label）\n    document.querySelectorAll('span, a, [aria-label]').forEach((el) => {\n      if (el.childElementCount > 3) return;\n      const label = el.getAttribute('aria-label') || el.textContent.trim();\n      if (!SPONSORED_TEXT.test(label)) return;\n      const unit = findUnit(el);\n      if (unit) hideEl(unit);\n    });\n\n    // 推荐：头部区域里有 Follow / Join 按钮的帖子\n    document.querySelectorAll('[role=\"button\"], a, span').forEach((el) => {\n      if (el.childElementCount > 0 || !FOLLOW_TEXT.test(el.textContent.trim())) return;\n      const unit = findUnit(el);\n      if (!unit || unit.style.display === 'none') return;\n      if (el.closest('[role=\"article\"]') !== unit.querySelector('[role=\"article\"]') && !unit.matches('[role=\"article\"]')) {\n        // 属于评论里嵌套的 article，不是帖子本身的头部\n        return;\n      }\n      const offset = el.getBoundingClientRect().top - unit.getBoundingClientRect().top;\n      if (offset >= 0 && offset < HEADER_MAX_PX) hideEl(unit);\n    });\n  }\n\n  // ---------- 启动 ----------\n  if (redirectIfReel()) return;\n  injectCSS();\n  hookHistory();\n  hookClicks();\n\n  // 节流的 MutationObserver：每帧最多跑一次 hideByText\n  let scheduled = false;\n  const observer = new MutationObserver(() => {\n    if (scheduled) return;\n    scheduled = true;\n    requestAnimationFrame(() => {\n      scheduled = false;\n      hideByText();\n      hideAdsAndSuggested();\n    });\n  });\n  // href 是 hover 时才被 Facebook 填进广告链接的，所以也要监听这个属性\n  observer.observe(document.documentElement, {\n    childList: true,\n    subtree: true,\n    attributes: true,\n    attributeFilter: ['href'],\n  });\n})();\n"}