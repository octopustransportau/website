{"version":2,"custom":{"origInclude":true,"origExclude":true,"origMatch":true,"origExcludeMatch":true,"origTag":true,"pathMap":{}},"config":{"enabled":1,"shouldUpdate":1,"httpOnly":0,"removed":0},"props":{"lastUpdated":1793180375248},"code":"// ==UserScript==\n// @name         YouTube: Block Shorts\n// @namespace    octopus.tool.bmm\n// @version      1.0.0\n// @description  屏蔽 YouTube 上所有 Shorts：首页/搜索/订阅/侧栏/频道页/推荐，并把 /shorts/ 链接重定向到普通播放页\n// @match        https://www.youtube.com/*\n// @match        https://m.youtube.com/*\n// @run-at       document-start\n// @grant        none\n// ==/UserScript==\n\n/*\n * 三层防线：\n *   1. CSS（document-start 注入）：页面渲染前就生效，没有“先闪一下再消失”。\n *      依赖 :has()，Firefox 121+ 支持。\n *   2. URL 重定向：/shorts/<id> → /watch?v=<id>。YouTube 是 SPA，\n *      所以除了首屏还要监听它自己的 yt-navigate-* 事件。\n *   3. MutationObserver：处理 CSS 无法按“文字内容”匹配的元素\n *      （搜索页的 “Shorts” 筛选 chip、频道页的 Shorts 标签）。\n */\n(function () {\n  'use strict';\n\n  const SHORTS_LINK = 'a[href^=\"/shorts/\"], a[href*=\"youtube.com/shorts/\"]';\n\n  // ---------- 1. CSS ----------\n  const CSS = `\n    /* 侧栏 / 迷你侧栏的 \"Shorts\" 入口 */\n    ytd-guide-entry-renderer:has(a[href=\"/shorts/\"]),\n    ytd-guide-entry-renderer:has(a[title=\"Shorts\"]),\n    ytd-mini-guide-entry-renderer:has(a[href=\"/shorts/\"]),\n    ytd-mini-guide-entry-renderer[aria-label=\"Shorts\"],\n\n    /* 首页 / 订阅 / 搜索 / 播放页右侧 的 Shorts 横排货架 */\n    ytd-reel-shelf-renderer,\n    ytd-rich-shelf-renderer[is-shorts],\n    ytd-rich-section-renderer:has(ytd-rich-shelf-renderer[is-shorts]),\n    ytd-rich-section-renderer:has(ytm-shorts-lockup-view-model),\n    ytd-rich-section-renderer:has(ytm-shorts-lockup-view-model-v2),\n    grid-shelf-view-model:has(${SHORTS_LINK}),\n    ytd-item-section-renderer:has(> #contents > ytd-reel-shelf-renderer:only-child),\n\n    /* 单条 Shorts 卡片（混在普通视频列表里的） */\n    ytd-rich-item-renderer:has(${SHORTS_LINK}),\n    ytd-video-renderer:has(${SHORTS_LINK}),\n    ytd-grid-video-renderer:has(${SHORTS_LINK}),\n    ytd-compact-video-renderer:has(${SHORTS_LINK}),\n    ytd-playlist-video-renderer:has(${SHORTS_LINK}),\n    yt-lockup-view-model:has(${SHORTS_LINK}),\n    ytm-shorts-lockup-view-model,\n    ytm-shorts-lockup-view-model-v2,\n    ytd-video-renderer:has(ytd-thumbnail-overlay-time-status-renderer[overlay-style=\"SHORTS\"]),\n    ytd-grid-video-renderer:has(ytd-thumbnail-overlay-time-status-renderer[overlay-style=\"SHORTS\"]),\n    ytd-compact-video-renderer:has(ytd-thumbnail-overlay-time-status-renderer[overlay-style=\"SHORTS\"]),\n\n    /* 频道页 Shorts 标签 */\n    yt-tab-shape[tab-title=\"Shorts\"],\n    tp-yt-paper-tab:has(> .tab-content[title=\"Shorts\"]),\n\n    /* 移动版 m.youtube.com */\n    ytm-reel-shelf-renderer,\n    ytm-rich-section-renderer:has(ytm-reel-shelf-renderer),\n    ytm-rich-section-renderer:has(ytm-shorts-lockup-view-model),\n    ytm-rich-section-renderer:has(ytm-shorts-lockup-view-model-v2),\n    ytm-video-with-context-renderer:has(${SHORTS_LINK}),\n    ytm-rich-item-renderer:has(${SHORTS_LINK}),\n    ytm-pivot-bar-item-renderer:has(.pivot-shorts)\n    {\n      display: none !important;\n    }\n  `;\n\n  function injectCSS() {\n    const style = document.createElement('style');\n    style.id = 'yt-block-shorts';\n    style.textContent = CSS;\n    (document.head || document.documentElement).appendChild(style);\n  }\n\n  // ---------- 2. 重定向 ----------\n  function redirectIfShorts(url) {\n    const m = (url || location.href).match(/\\/shorts\\/([\\w-]{6,})/);\n    if (!m) return false;\n    const target = `${location.origin}/watch?v=${m[1]}`;\n    if (location.href !== target) location.replace(target);\n    return true;\n  }\n\n  // ---------- 3. 按文字匹配的元素 ----------\n  function hideByText() {\n    // 搜索结果顶部的 \"Shorts\" 筛选 chip\n    document\n      .querySelectorAll('yt-chip-cloud-chip-renderer, chip-shape, yt-chip-shape')\n      .forEach((el) => {\n        if (el.textContent.trim() === 'Shorts') el.style.setProperty('display', 'none', 'important');\n      });\n    // 频道页标签（旧版 DOM 上没有 tab-title 属性时兜底）\n    document.querySelectorAll('yt-tab-shape, tp-yt-paper-tab').forEach((el) => {\n      if (el.textContent.trim() === 'Shorts') el.style.setProperty('display', 'none', 'important');\n    });\n  }\n\n  // ---------- 启动 ----------\n  if (redirectIfShorts()) return;\n  injectCSS();\n\n  // SPA 内部跳转：在导航开始时就拦截，避免 Shorts 播放器先加载\n  document.addEventListener('yt-navigate-start', (e) => {\n    const url = e.detail && e.detail.url;\n    if (url && url.includes('/shorts/')) redirectIfShorts(url);\n  });\n  document.addEventListener('yt-navigate-finish', () => redirectIfShorts());\n  window.addEventListener('popstate', () => redirectIfShorts());\n\n  // 节流的 MutationObserver：每帧最多跑一次 hideByText\n  let scheduled = false;\n  const observer = new MutationObserver(() => {\n    if (scheduled) return;\n    scheduled = true;\n    requestAnimationFrame(() => {\n      scheduled = false;\n      hideByText();\n    });\n  });\n  observer.observe(document.documentElement, { childList: true, subtree: true });\n})();\n"}